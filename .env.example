# Copy to apps/web/.env.local and fill in real values.

# Postgres connection string (local Postgres, or Neon in production)
DATABASE_URL=postgresql://user:password@localhost:5432/matchmind

# API-Sports key — https://dashboard.api-football.com
FOOTBALL_API_KEY=your-api-sports-key

# Guards the /api/sync and /api/predictions/tune routes.
# Generate with: openssl rand -hex 32
CRON_SECRET=your-generated-secret
